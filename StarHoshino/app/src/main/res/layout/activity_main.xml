<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <VideoView
        android:id="@+id/videoWallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC0D1117" />

    <FrameLayout
        android:id="@+id/discContainer"
        android:layout_width="312px"
        android:layout_height="312px"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_marginBottom="220dp">

        <ImageView
            android:id="@+id/discImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:background="@color/disc_bg"
            android:contentDescription="圆盘" />

        <VideoView
            android:id="@+id/discVideo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>

    <com.example.starhoshino.ui.WaveCanvas
        android:id="@+id/waveCanvas"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_marginBottom="150dp" />

    <Button
        android:id="@+id/btnSoulTest"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/soul_test"
        android:textColor="@color/text_primary"
        android:backgroundTint="@color/primary" />

</FrameLayout>
